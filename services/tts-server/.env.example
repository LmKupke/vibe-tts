# Core service
VIBE_TTS_HOST=127.0.0.1
VIBE_TTS_PORT=8765
VIBE_TTS_DEVICE=auto
VIBE_TTS_MAX_TEXT_LENGTH=5000
# Prefer the installed extension's exact chrome-extension://<id> origin here.
VIBE_TTS_CORS_ORIGINS=
# Development fallback; set this blank to disable regex matching when using exact origins.
VIBE_TTS_CORS_ORIGIN_REGEX=^chrome-extension://[a-p]{32}$
VIBE_TTS_OFFLINE=0

# Deterministic development provider
VIBE_TTS_ENABLE_MOCK=1

# TADA (CUDA only in this adapter)
VIBE_TTS_ENABLE_TADA=0
VIBE_TTS_TADA_CHECKPOINT=HumeAI/tada-3b-ml
VIBE_TTS_TADA_ENCODER_CHECKPOINT=HumeAI/tada-codec
VIBE_TTS_TADA_PROMPT_AUDIO=
VIBE_TTS_TADA_PROMPT_TRANSCRIPT=
VIBE_TTS_TADA_PROMPT_LANGUAGE=
VIBE_TTS_TADA_REQUIRE_ALIGNMENT=1

# Qwen3-TTS
VIBE_TTS_ENABLE_QWEN=0
VIBE_TTS_QWEN_CHECKPOINT=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
VIBE_TTS_QWEN_DEFAULT_VOICE=Ryan
VIBE_TTS_QWEN_REFERENCE_AUDIO=
VIBE_TTS_QWEN_REFERENCE_TRANSCRIPT=
VIBE_TTS_QWEN_ALLOW_EXPERIMENTAL_DEVICE=0
VIBE_TTS_QWEN_USE_FLASH_ATTENTION=0
